# Copiá este archivo como .env y completá los valores.
PORT=3000
# Contraseña para ingresar al panel (/admin)
ADMIN_PASSWORD=cambiame
# Cadena aleatoria de al menos 32 caracteres. Generala con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Carpeta donde se guardan las consultas (por defecto ./data)
# DATA_DIR=./data
# En producción (detrás de HTTPS) poné NODE_ENV=production
# NODE_ENV=production
